      "group": "daily",
      "url": "/news/",
      "schedule": {
        "days": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "time": "07:30"
      },
      "accent": "#e8b04a",
      "source": {
        "type": "index",
        "index": "/news/data/index.json",
        "list": "editions",
        "label": "제{issue}호",
