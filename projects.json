      "url": "/question/",
      "accent": "#1f4fd8",
      "statusText": "지금까지 질문 {count}개",
      "emptyText": "첫 질문을 기다리는 중",
      "source": {
        "type": "index",
        "index": "/question/data/index.json",
        "list": "questions",
        "label": "Q{no|pad2}",
        "title": "{title}",
        "chip": "{cat.name}",
        "link": "/question/#/t/{id}",
        "lookup": {
          "cat": {
            "list": "categories",
            "key": "id",
            "field": "category"
          }
        }
      },
      "cover": {
        "style": "type",
        "mast": "Seok's Question",
        "sub": "하나의 질문을 여러 학문의 눈으로",
        "empty": "첫 질문을 기다리는 중"
      }
